<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hallmark · component: hanging card · custom glass / warm cord.
         Pre-emit critique: Philosophy 4 Hierarchy 4 Execution 4 Specificity 5 Restraint 4 Variety 4. -->
    <Color x:Key="InkColor">#293A42</Color>
    <Color x:Key="PaperColor">#F5F7F8</Color>
    <Color x:Key="AccentColor">#247B79</Color>
    <Color x:Key="CordColor">#B89F7D</Color>
    <Color x:Key="HighlightColor">#F8FFFFFF</Color>
    <Color x:Key="GlassTopColor">#EAF7FCFF</Color>
    <Color x:Key="GlassBottomColor">#B3D5E2E7</Color>
    <Color x:Key="PegLightColor">#F5DDAC</Color>
    <Color x:Key="PegDarkColor">#B68A55</Color>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Cord" Color="{StaticResource CordColor}" />
    <SolidColorBrush x:Key="Highlight" Color="{StaticResource HighlightColor}" />
    <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="{StaticResource GlassTopColor}" /><GradientStop Color="{StaticResource GlassBottomColor}" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="Wood" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{StaticResource PegLightColor}" /><GradientStop Color="{StaticResource PegDarkColor}" Offset="1" /></LinearGradientBrush>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="4" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10" /></Style>
    <SolidColorBrush x:Key="DarkInk" Color="#E8F1F4" />
    <SolidColorBrush x:Key="DarkPaper" Color="#263840" />
    <SolidColorBrush x:Key="DarkHighlight" Color="#7AA9BDC5" />
    <LinearGradientBrush x:Key="DarkGlass" StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#EE3B515C" /><GradientStop Color="#C025363F" Offset="1" /></LinearGradientBrush>
</ResourceDictionary>
